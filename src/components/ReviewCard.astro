---
import Brand from './Brand.astro';
interface Props { quote: string; name: string; country: string; note?: string }
const { quote, name, country, note } = Astro.props;
const star = 'M11.48 3.5a.56.56 0 0 1 1.04 0l2.13 5.11a.56.56 0 0 0 .47.35l5.52.44c.5.04.7.66.32.99l-4.2 3.6a.56.56 0 0 0-.18.55l1.28 5.39a.56.56 0 0 1-.84.61l-4.73-2.89a.56.56 0 0 0-.58 0l-4.73 2.89a.56.56 0 0 1-.84-.61l1.28-5.39a.56.56 0 0 0-.18-.55l-4.2-3.6a.56.56 0 0 1 .32-.99l5.52-.44a.56.56 0 0 0 .47-.35z';
---
<figure class="review">
  <div class="review__stars" role="img" aria-label="Rated 5 out of 5">
    {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={star} /></svg>)}
  </div>
  <blockquote><p>“{quote}”</p></blockquote>
  <figcaption>
    <span class="review__initial" aria-hidden="true">{name[0].toUpperCase()}</span>
    <span><span class="review__name">{name}{note && ` · ${note}`}</span><span class="review__meta">{country}</span></span>
  </figcaption>
  <span class="review__source"><Brand name="fiverr" mono="#4A5568" decorative />Verified Fiverr review</span>
</figure>
