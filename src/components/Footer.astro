---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { SITE, CTA, FORMS } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <section class="footer-news" id="newsletter" aria-labelledby="news-title">
      <div class="footer-news__copy">
        <p class="footer-news__eyebrow">Newsletter</p>
        <h2 id="news-title">The <em>Seeding</em> Report</h2>
        <p>One short email a month for beauty founders: what’s working in creator seeding, cost per post math, and plays you can copy. Unsubscribe any time.</p>
      </div>
      <div class="footer-news__form">
        <form class="news-form" action={FORMS.newsletter} method="post" data-form="newsletter" data-success="news-success">
          <div class="news-form__row">
            <div class="news-field"><label for="n-name">First name <span>(optional)</span></label><input id="n-name" name="fields[name]" type="text" autocomplete="given-name" /></div>
            <div class="news-field"><label for="n-email">Email</label><input id="n-email" name="fields[email]" type="email" autocomplete="email" required /></div>
            <button class="btn btn--on-dark" type="submit">Subscribe</button>
          </div>
          <div class="hp" aria-hidden="true"><label for="n-hp">Leave this empty</label><input id="n-hp" name="company_url" type="text" tabindex="-1" autocomplete="off" /></div>
          <input type="hidden" name="form" value="newsletter" /><input type="hidden" name="ts" value="" />
        </form>
        <div class="form-success news-success" id="news-success" tabindex="-1" role="status">
          <h3>You’re in.</h3>
          <p>The next Seeding Report lands in your inbox.</p>
        </div>
      </div>
    </section>

    <div class="footer-top">
      <div class="footer-brand">
        <img src="/images/brand/logo-primary-reversed.svg" width="190" height="27" alt="Influencer Orbit" loading="lazy" />
        <p>Creator seeding for DTC skincare, cosmetics and beauty brands. Guaranteed creator posts every month, and your best ones become ads.</p>
        <a class="btn btn--on-dark btn--sm" href="/book" data-cta="footer"><Icon name="calendar" />{CTA.primary}</a>
      </div>
      <nav class="footer-col" aria-labelledby="f-explore">
        <h2 id="f-explore">Explore</h2>
        <ul>
          <li><a href="/creator-seeding">How it works</a></li>
          <li><a href="/creator-seeding#pricing">Pricing</a></li>
          <li><a href="/case-studies">Case study</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="f-start">
        <h2 id="f-start">Get started</h2>
        <ul>
          <li><a href="/book">Book a walkthrough</a></li>
          <li><a href="/competitor-audit">Free Competitor Audit</a></li>
          <li><a href="#newsletter">The Seeding Report</a></li>
        </ul>
      </nav>
      <div class="footer-col footer-col--contact">
        <h2>Contact</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li class="muted-line">{SITE.responseTime}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-legal">
        <p>© {year} Influencer Orbit</p>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
      <div class="footer-social">
        <a href={SITE.social.linkedin} target="_blank" rel="me noopener" aria-label="Tayyab Habib on LinkedIn"><Brand name="linkedin" mono="#FFFFFF" decorative /></a>
        <a href={SITE.social.instagram} target="_blank" rel="me noopener" aria-label="Influencer Orbit on Instagram"><Brand name="instagram" mono="#FFFFFF" decorative /></a>
      </div>
    </div>
  </div>
</footer>
