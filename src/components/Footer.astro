---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { SITE, CTA } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/images/brand/logo-primary-reversed.svg" width="190" height="27" alt="Influencer Orbit" loading="lazy" />
        <p>The creator seeding operation that gets US beauty brands 50 to 150+ confirmed creator posts every month, without hiring a team.</p>
        <a class="btn btn--on-dark" href="/book" data-cta="footer"><Icon name="calendar" />{CTA.primary}</a>
      </div>
      <nav class="footer-col" aria-labelledby="f-explore">
        <h2 id="f-explore">Explore</h2>
        <ul>
          <li><a href="/creator-seeding">Seeding Engine</a></li>
          <li><a href="/creator-seeding#pricing">Pricing</a></li>
          <li><a href="/case-studies">Case studies</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="f-start">
        <h2 id="f-start">Get started</h2>
        <ul>
          <li><a href="/book">Book a walkthrough</a></li>
          <li><a href="/competitor-audit">Free Competitor Audit</a></li>
        </ul>
      </nav>
      <div class="footer-col footer-col--contact">
        <h2>Contact</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li class="muted-line">{SITE.responseTime}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-legal">
        <p>© {year} Influencer Orbit</p>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
      <div class="footer-social">
        <a href={SITE.social.linkedin} target="_blank" rel="me noopener" aria-label="Tayyab Habib on LinkedIn"><Brand name="linkedin" mono="#FFFFFF" decorative /></a>
        <a href={SITE.social.instagram} target="_blank" rel="me noopener" aria-label="Influencer Orbit on Instagram"><Brand name="instagram" mono="#FFFFFF" decorative /></a>
      </div>
    </div>
  </div>
</footer>
