---
import Icon from './Icon.astro';
import { NAV, CTA } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && href === path;
---
<div class="announce">
  <span class="announce__lead">2,483 creator posts live for one beauty brand since January 2024.</span> <a href="/case-studies">See the case study →</a>
</div>
<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="site-header__logo" href="/" aria-label="Influencer Orbit home">
      <img src="/images/brand/logo-primary.svg" width="178" height="25" alt="Influencer Orbit" />
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {NAV.map((n) => (<li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>))}
      </ul>
    </nav>
    <a class="btn btn--primary btn--sm site-header__cta" href="/book" data-cta="header"><Icon name="calendar" />Book a call</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span class="sr-only">Menu</span><Icon name="menu" />
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
    <div class="container">
      <ul>{NAV.map((n) => (<li><a href={n.href}>{n.label}</a></li>))}</ul>
      <a class="btn btn--primary" href="/book" data-cta="mobile-menu"><Icon name="calendar" />{CTA.primary}</a>
    </div>
  </nav>
</header>
