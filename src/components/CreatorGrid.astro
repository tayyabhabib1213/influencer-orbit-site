---
import { CREATORS } from '../data/content';
interface Props { count?: number; wide?: boolean; caption?: string }
const { count = 9, wide = false, caption = 'Creator posts from the Esther Formula program, 2024 to 2025. Shared with the brand’s permission.' } = Astro.props;
const items = CREATORS.slice(0, count);
---
<figure style="margin:0">
  <div class={`creators${wide ? ' creators--wide' : ''}`}>
    {items.map((c) => (
      <picture>
        <source type="image/avif" srcset={`/images/creators/${c.file}-${c.width}.avif`} />
        <img src={`/images/creators/${c.file}-${c.width}.webp`} width={c.width} height={Math.round(c.width * 1.25)} alt={c.alt} loading="lazy" decoding="async" />
      </picture>
    ))}
  </div>
  <figcaption class="creators-caption">{caption}</figcaption>
</figure>
