---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../data/site';
import { breadcrumb } from '../data/schema';
const crumbs = [{ name: 'Terms of use', path: '/terms' }];
---
<BaseLayout title="Terms of Use · Influencer Orbit" description="The terms that apply when you use the Influencer Orbit website, free audit and downloads." path="/terms" schema={[breadcrumb(crumbs)]}>
  <section class="page-hero legal-hero">
    <div class="container legal">
      <Breadcrumbs items={crumbs} />
      <h1 class="display-lg">Terms of use</h1>
      <p class="muted">Last updated: November 1, 2026</p>

      <h2>Using this site</h2>
      <p>By using {SITE.url.replace('https://', '')} you agree to these terms. If you don’t agree, please don’t use the site.</p>

      <h2>Information, not a contract</h2>
      <p>Pricing, timelines and the post-count guarantee described on this site summarise our standard offer. The binding terms of any engagement, including the guarantee and its conditions, are set out in the proposal and agreement you sign with us.</p>

      <h2>Free audit and downloads</h2>
      <p>The Competitor Creator Audit and any guides are provided free, for your internal use, based on publicly available content. They are general information, not a promise of results. Availability is limited to the brands we serve and may change.</p>

      <h2>Our content</h2>
      <p>The text, design, logo and graphics on this site belong to Influencer Orbit. Creator content and third-party logos shown belong to their owners and appear with permission or for identification. Please don’t copy or reuse our content without written permission.</p>

      <h2>Third-party services</h2>
      <p>The site links to and embeds third-party services such as Calendly. Their own terms apply to your use of them.</p>

      <h2>No warranties and limits of liability</h2>
      <p>The site is provided “as is”. To the extent the law allows, we are not liable for indirect or consequential losses arising from your use of the site.</p>

      <h2>Changes and contact</h2>
      <p>We may update these terms and will change the date above when we do. Questions: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    </div>
  </section>
</BaseLayout>
