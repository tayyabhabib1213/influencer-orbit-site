---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { SITE, FORMS, PROOF, PRICE_FROM, estherMonths } from '../data/site';
import { REVIEWS } from '../data/content';
import { breadcrumb } from '../data/schema';
const months = estherMonths();
const crumbs = [{ name: 'Book a walkthrough', path: '/book' }];
const calUrl = `${SITE.calendly}?hide_gdpr_banner=1&primary_color=0b3aa6`;
---
<BaseLayout
  title="Book a Walkthrough · Influencer Orbit"
  description="See the live tracker and a real report in 20 minutes, get your plan and your exact quote. Creator seeding for DTC beauty brands."
  path="/book"
  schema={[breadcrumb(crumbs)]}
  stickyCta={false}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Book a walkthrough</p>
      <h1 class="h-hero">See the live tracker. <em>Get your exact quote.</em></h1>
      <p class="lead">20 minutes. We’ll show you the real Esther Formula tracker (redacted) and the report you’d receive, recommend a plan, and give you a price.</p>
    </div>
  </section>

  <section class="section section--tight" aria-label="Booking calendar and what to expect">
    <div class="container booking">
      <div class="calendly-box">
        <div class="calendly-inline-widget" data-url={calUrl}></div>
        <noscript><p class="calendly-fallback"><a class="btn btn--primary" href={SITE.calendly}>Open the booking calendar</a></p></noscript>
        <p class="calendly-fallback">Calendar not loading? <a href={SITE.calendly} target="_blank" rel="noopener">Book on Calendly directly</a>.</p>
      </div>
      <aside class="booking__aside" aria-labelledby="call-title">
        <div class="card">
          <h2 id="call-title" class="h-md">What happens on the call</h2>
          <ol class="agenda">
            <li><span class="agenda__t">Min 0 to 5</span><span>Your current program: posts a month, post rate, who runs it and where it stalls.</span></li>
            <li><span class="agenda__t">Min 5 to 13</span><span>The live tracker and report, inside a real account (redacted).</span></li>
            <li><span class="agenda__t">Min 13 to 20</span><span>The right plan for you, your exact price, guarantee terms in writing, and an honest fit check.</span></li>
          </ol>
          <p class="muted small" style="margin:16px 0 0">No pitch deck. If it isn’t a fit, we’ll say so on the call.</p>
        </div>
        <div class="big-number" style="padding:28px">
          <ul class="checks">
            <li><Icon name="check" /><span><span data-months>{months}</span> months running for the same beauty brand</span></li>
            <li><Icon name="check" /><span>2,000+ creator collaborations, {PROOF.totalPosts} posts live</span></li>
            <li><Icon name="check" /><span>Plans from {PRICE_FROM} a month</span></li>
            <li><Icon name="check" /><span>Post count guaranteed by day 60</span></li>
          </ul>
        </div>
        <ReviewCard {...REVIEWS[0]} />
      </aside>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="email-title">
    <div class="container">
      <div class="split split--wide-left">
        <div>
          <p class="eyebrow">Prefer email?</p>
          <h2 id="email-title" class="h-xl">Start with a <em>quick note</em>.</h2>
          <p class="lead mt-6">Tell us a little about your brand and we’ll come back with a recommended plan. {SITE.responseTime}</p>
          <ul class="contact-list">
            <li><Icon name="mail" /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><Icon name="user-check" /><a href={SITE.founder.linkedin} target="_blank" rel="noopener">Tayyab Habib on LinkedIn</a></li>
            <li><Icon name="clock" /><span>One business day, by email, Slack or WhatsApp</span></li>
          </ul>
        </div>
        <div class="panel">
          <form class="form" action={FORMS.contact} method="post" data-form="contact" data-success="contact-success">
            <div class="form-grid">
              <div class="field"><label for="c-name">Name</label><input id="c-name" name="fields[name]" type="text" autocomplete="name" required /></div>
              <div class="field"><label for="c-email">Work email</label><input id="c-email" name="fields[email]" type="email" autocomplete="email" required /></div>
            </div>
            <div class="field"><label for="c-site">Brand website</label><input id="c-site" name="fields[website]" type="url" inputmode="url" placeholder="https://" autocomplete="url" required /></div>
            <div class="form-grid">
              <div class="field"><label for="c-rev">Annual revenue</label>
                <select id="c-rev" name="fields[revenue]" required><option value="">Select</option><option>Under $500K</option><option>$500K to $3M</option><option>$3M to $10M</option><option>$10M+</option></select></div>
              <div class="field"><label for="c-posts">Creator posts a month now</label>
                <select id="c-posts" name="fields[creator_posts]" required><option value="">Select</option><option>0 to 15</option><option>15 to 50</option><option>50 to 100</option><option>100+</option></select></div>
            </div>
            <div class="field"><label for="c-problem">What’s the biggest problem with your creator program? <span class="hint">(optional)</span></label><textarea id="c-problem" name="fields[problem]" rows="3"></textarea></div>
            <div class="hp" aria-hidden="true"><label for="c-hp">Leave this empty</label><input id="c-hp" name="company_url" type="text" tabindex="-1" autocomplete="off" /></div>
            <input type="hidden" name="form" value="contact" /><input type="hidden" name="ts" value="" />
            <button class="btn btn--primary btn--block" type="submit">Send it</button>
            <p class="form-note">{SITE.responseTime} DTC skincare, cosmetics and beauty brands only.</p>
          </form>
          <div class="form-success" id="contact-success" tabindex="-1" role="status">
            <h3>Got it.</h3>
            <p>We’ll reply within one business day. While you wait, <a href="/case-studies">read the Esther Formula case study</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
