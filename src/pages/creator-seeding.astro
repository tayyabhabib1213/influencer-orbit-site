---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { TIERS, CTA, estherMonths } from '../data/site';
import { SERVICE_FAQS } from '../data/content';
import { faqPage, breadcrumb, services } from '../data/schema';
const months = estherMonths();
const crumbs = [{ name: 'Seeding Engine', path: '/creator-seeding' }];

const included = [
  ['scan-search', 'Competitor Creator Audit', 'See which creators post for 3 of your competitors and which hooks win, before you approve a brief'],
  ['file-text', 'Creator brief + outreach scripts', 'Written from the audit, approved by you within 48 hours'],
  ['user-check', 'Hand-vetted creators', 'Chosen for audience fit, engagement quality and content match, not follower count'],
  ['package', 'Confirm-first shipping', 'No product ships until the creator confirms. Addresses sent to your warehouse daily'],
  ['send', 'Follow-up to live', 'We chase every post until it’s live. You chase no one'],
  ['list-checks', 'Live shared tracker', 'Every creator, shipment and post link in real time, from day one'],
  ['zap', 'Spark Ads / whitelisting setup', 'Your best posts turned into ads from day 30'],
  ['star', 'VIP Creator Roster', 'Top performers kept for repeat seeding and paid collabs, and the roster is yours'],
  ['chart-no-axes-column', 'Monthly report', 'Posts vs target, views, reach, engagement, unique creators, code and link sales, top 10 ad-ready posts']
];

const timeline = [
  ['Days 1–2', 'Kickoff', 'Pilot paid, kickoff call, Competitor Creator Audit starts within 48 hours.'],
  ['Days 1–5', 'Audit and brief', 'You see the competitor creator map, then approve the brief and scripts. Outreach goes live by day 5.'],
  ['Days 5–21', 'Vet and confirm', 'Creators are hand-vetted and confirmed. Your warehouse ships within three business days of each confirmation.'],
  ['Day 21', 'First posts live', 'Every post appears in your tracker the moment it’s confirmed live.'],
  ['Day 30', 'First report and first Spark Ads', 'Top 10 ad-ready posts go to your media buyer, and top creators join your VIP Roster.'],
  ['Day 60', 'Guarantee checkpoint', 'Your tier’s monthly post count is live, or month three is free.']
];

const compare = {
  cols: ['Orbit Seeding Engine', 'In-house coordinator', 'Influencer software', 'Pay-per-post marketplace', 'Bought UGC'],
  rows: [
    ['Cost', '$1,500–$3,500/mo', '~$61K/yr + software', '$399–$1,799/mo + an operator', '~$30 per post', '$150–$400 per video'],
    ['Who does the work', 'We do', 'Your hire', 'Your team', 'Shared', 'Freelancer'],
    ['Post count guaranteed', 'Yes, by day 60', 'No', 'No', 'Per post', 'Per video'],
    ['Creators picked for your customer', 'Hand-vetted', 'Yes', 'Your team picks', 'From their opt-in pool', 'No'],
    ['You own creator relationships', 'Yes', 'Until they leave', 'Yes', 'No', 'No'],
    ['TikTok search presence', 'Yes', 'Limited by one person', 'Depends on operator', 'Some', 'No'],
    ['Spark Ads pipeline', 'Included', 'Extra work', 'Extra work', 'No', 'Ads only']
  ]
};
---
<BaseLayout
  title="Product Seeding Agency: Pricing & Process · Influencer Orbit"
  description="Done-for-you creator seeding from $1,500/month. 60-day pilot, post-count guarantee by day 60, and you own every creator relationship."
  path="/creator-seeding"
  schema={[breadcrumb(crumbs), faqPage(SERVICE_FAQS), ...services()]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">The Orbit Seeding Engine</p>
      <h1 class="display-xl">50 to 150+ real creator posts every month, <em>without hiring an influencer team.</em></h1>
      <p class="lead">We run your creator seeding program end to end, from finding and vetting creators to coordinating every shipment and chasing every post to live. You approve a brief and ship product from your own warehouse.</p>
      <div class="cta-group">
        <a class="btn btn--primary" href="/book" data-cta="services-hero"><Icon name="calendar" />{CTA.primary}</a>
        <a class="text-link" href="#pricing">Jump to pricing <Icon name="chevron-down" /></a>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="changes-title">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 id="changes-title" class="display-lg">What <em>changes for you</em></h2>
      </div>
      <div class="grid grid--3">
        <div class="card reveal"><span class="icon-tile"><Icon name="search" /></span><h3 class="heading-sm">You show up in TikTok search.</h3><p>50 to 150+ different real creators post about your product every month, not the same three faces on rotation.</p></div>
        <div class="card reveal"><span class="icon-tile"><Icon name="video" /></span><h3 class="heading-sm">Your ad account never runs dry.</h3><p>A fresh batch of Spark Ad-ready creator content arrives every month, so creative fatigue stops driving up your CPA.</p></div>
        <div class="card reveal"><span class="icon-tile"><Icon name="clock" /></span><h3 class="heading-sm">The busywork disappears.</h3><p>No coordinator salary, no chasing, no spreadsheets, and none of the waste from cold gifting, where only 30% to 50% of creators post. Our confirm-first post rate is 70%+.</p></div>
      </div>
    </div>
  </section>

  <section class="section" id="how-it-works" aria-labelledby="included-title">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 id="included-title" class="display-lg">Everything it takes to get a post live, <em>every month</em>.</h2>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="included-title">
        <table class="data-table">
          <thead><tr><th scope="col">Component</th><th scope="col">Why it’s there</th></tr></thead>
          <tbody>
            {included.map(([icon, name, why]) => (
              <tr><th scope="row"><span style="display:inline-flex;gap:10px;align-items:center"><Icon name={icon} class="icon icon--sm" />{name}</span></th><td>{why}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="timeline-title">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 id="timeline-title" class="display-lg">Your first <em>60 days</em></h2>
      </div>
      <ol class="steps steps--3">
        {timeline.map(([when, title, text], i) => (
          <li class="step reveal">
            <div class="step__top"><span class="icon-tile"><Icon name={['handshake', 'scan-search', 'user-check', 'circle-play', 'chart-no-axes-column', 'shield-check'][i]} /></span><span class="step__when">{when}</span></div>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <div class="callout">
        <strong>Already running seeding in-house?</strong>
        <p>We import your existing roster and tracker and work alongside your current setup. Volume doesn’t dip during the transition.</p>
      </div>
    </div>
  </section>

  <section class="section" id="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 id="pricing-title" class="display-lg">Priced per program. <em>Measured per post.</em></h2>
      </div>
      <div class="tiers">
        {TIERS.map((t) => (
          <article class={`tier${t.popular ? ' tier--popular' : ''}`} id={t.id}>
            {t.popular && <span class="tier__badge">Most popular</span>}
            <h3>{t.name}</h3>
            <p class="tier__price">${t.price.toLocaleString('en-US')}<span> / month</span></p>
            <p class="tier__posts"><strong>{t.posts.split(',')[0]}</strong> {t.posts.includes(',') ? 'creator posts a month, plus paid collab management' : 'creator posts a month'}</p>
            <p class="tier__meta">Management cost {t.perPost} per post</p>
            <p><strong>Best for:</strong> {t.bestFor}</p>
            <a class={`btn ${t.popular ? 'btn--primary' : 'btn--secondary'}`} href="/book" data-cta={`tier-${t.id}`}>Start with a walkthrough</a>
          </article>
        ))}
      </div>
      <div class="grid grid--2 grid--gap-lg mt-12 terms-split">
        <div>
          <h3 class="heading-sm mb-6">Terms in one glance</h3>
          <ul class="terms">
            <li><Icon name="check" /><span>60-day pilot, then month to month. No long lock-in.</span></li>
            <li><Icon name="check" /><span>$500 kickoff fee, waived when you prepay the pilot.</span></li>
            <li><Icon name="check" /><span>Need more? Top up 25 posts for $750. Prepay a quarter and save 10%.</span></li>
            <li><Icon name="check" /><span>Prefer to pay per result? $1,000/month + $20 per live post, 3-month minimum.</span></li>
            <li><Icon name="check" /><span>You pay product cost, shipping and any creator fees directly. We never mark them up.</span></li>
          </ul>
        </div>
        <div class="card card--flat">
          <span class="icon-tile"><Icon name="badge-dollar-sign" /></span>
          <h3 class="heading-sm">For context</h3>
          <p>One bought UGC video costs $150 to $400, and an in-house coordinator costs about $61K a year before software.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="guarantee" aria-labelledby="guarantee-title">
    <div class="container">
      <div class="guarantee reveal">
        <p class="guarantee__label"><Icon name="shield-check" />The guarantee</p>
        <h2 id="guarantee-title" class="display-lg">Your post count by day&nbsp;60, <em>or month three is free.</em></h2>
        <p>If your tier’s monthly post count isn’t live by day 60, month three is free. We keep working with no management fee until the number is hit.</p>
        <div class="guarantee__grid">
          <div><h3>Your side of it</h3><p>Product in stock, brief approvals within 48 hours, and shipping within three business days of confirmations.</p></div>
          <div><h3>What we don’t guarantee</h3><p>Views, sales or the algorithm. We guarantee posts because posting is what we control. Views, reach and code sales are in your monthly report so you can judge the channel honestly.</p></div>
          <div><h3>Ownership</h3><p>Every creator contact, every content link and the live tracker are yours, whether you stay or not.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white" id="compare" aria-labelledby="compare-title">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 id="compare-title" class="display-lg"><em>The Seeding Engine</em> vs. the other ways to get creator posts</h2>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="compare-title">
        <table class="data-table">
          <thead><tr><th scope="col"><span class="sr-only">Feature</span></th>{compare.cols.map((c, i) => <th scope="col" class={i === 0 ? 'is-us' : ''}>{c}</th>)}</tr></thead>
          <tbody>
            {compare.rows.map(([label, ...cells]) => (<tr><th scope="row">{label}</th>{cells.map((c, i) => <td class={i === 0 ? 'is-us' : ''}>{c}</td>)}</tr>))}
          </tbody>
        </table>
      </div>
      <p class="table-note">Ranges are typical published US figures as of 2026. Scroll the table sideways on small screens.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="proof-title">
    <div class="container">
      <div class="section-head">
        <h2 id="proof-title" class="display-lg"><em>Esther Formula</em> · <span data-months>{months}</span> months</h2>
        <p class="lead">The same confirm-first operation has run every month since January 2024. On the walkthrough you see the real tracker, redacted.</p>
      </div>
      <div class="proof-strip">
        <img src="/images/brand/esther-formula-logo.webp" width="869" height="96" alt="Esther Formula" loading="lazy" />
        <div class="chipline"><span>2,000+ creator collaborations</span><span>50–200 posts a month</span><span>0 influencer managers hired</span></div>
        <a class="text-link" href="/case-studies">Read the case studies <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="section section--white" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 id="faq-title" class="display-lg">Questions about the <em>Seeding Engine</em></h2>
      </div>
      <div class="faq-center"><Faq items={SERVICE_FAQS} /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="fit-title">
    <div class="container">
      <div class="section-head">
        <h2 id="fit-title" class="display-lg">This is the <em>wrong fit</em> if</h2>
      </div>
      <div class="fit-panel fit-panel--narrow">
        <ul class="fit fit--no">
          <li><Icon name="circle-x" /><span>Your warehouse can’t ship within three business days of creator confirmations</span></li>
          <li><Icon name="circle-x" /><span>You can’t approve briefs within 48 hours</span></li>
          <li><Icon name="circle-x" /><span>You need a guarantee on views or sales rather than posts</span></li>
          <li><Icon name="circle-x" /><span>You’re outside US skincare, cosmetics or beauty</span></li>
        </ul>
        <p class="mt-6 muted">We’ll tell you on the call, not after you’ve paid.</p>
      </div>
    </div>
  </section>

  <FinalCta
    title="See the tracker. Run the math. <em>Then decide.</em>"
    micro="If the fit is right, outreach goes live within five days of kickoff."
  />
</BaseLayout>
