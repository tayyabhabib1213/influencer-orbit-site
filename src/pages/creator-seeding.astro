---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHead from '../components/SectionHead.astro';
import Plans from '../components/Plans.astro';
import OrbitDiagram from '../components/OrbitDiagram.astro';
import Tracker from '../components/Tracker.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { TIERS, ADDONS, PRICE_FROM, PROOF } from '../data/site';
import { SERVICE_FAQS } from '../data/content';
import { faqPage, breadcrumb, services } from '../data/schema';
const crumbs = [{ name: 'How it works', path: '/creator-seeding' }];

const phases = [
  { n: 1, name: 'Map', when: 'Days 1 to 5', text: 'We study your brand and three of your closest competitors before a single creator is contacted.', items: ['Competitor Creator Audit', 'Creator brief and outreach scripts', 'Approved by you within 48 hours'] },
  { n: 2, name: 'Match & Ship', when: 'Days 5 to 21', text: 'Creators are hand-vetted and confirmed. Your warehouse only ships to people who said yes.', items: ['Vetted for audience fit, not follower count', 'Every creator confirms before shipping', 'Confirmed addresses sent to you daily'] },
  { n: 3, name: 'Go Live', when: 'Day 21 on', text: 'First posts go live and we chase every one until it shows up in your tracker.', items: ['Follow-up until every post is live', 'Live shared tracker from day one', 'FTC disclosure on every post'] },
  { n: 4, name: 'Amplify', when: 'Day 30 on', text: 'Posts become an asset: ads, a roster and a report you can act on.', items: ['UGC with usage rights for your ads', 'Spark Ads codes and whitelisting', 'VIP Creator Roster for repeat seeding'] }
];

const matrixRows: [string, (t: (typeof TIERS)[number]) => string][] = [
  ['Best for', (t) => t.bestFor],
  ['Guaranteed creator posts a month', (t) => t.posts],
  ['UGC assets with usage rights', (t) => t.ugc],
  ['Creator research, outreach, shipping coordination, post tracking', () => 'Included'],
  ['Top posts picked for Spark Ads', (t) => t.spark],
  ['Strategy calls', (t) => t.calls],
  ['Reporting', (t) => t.reporting]
];

const terms = [
  ['repeat', '60-day pilot, then month to month', 'Every plan starts with a 60-day pilot, billed monthly by Payoneer or Wise invoice. After that, stay month to month.'],
  ['badge-dollar-sign', 'Prepay 3 months, save 10%', 'Available on Orbit and Galaxy for brands that want to commit to a full quarter.'],
  ['layers', 'Start small, upgrade freely', 'Move from Liftoff to Orbit within 60 days and what you paid for Liftoff counts toward Orbit.'],
  ['shield-check', 'Two guarantees', 'First posts live within 21 days. Your monthly post count hit by day 60, from when you ship, or we work free until it is.']
];
---
<BaseLayout
  title="Creator Seeding Plans & Process · Influencer Orbit"
  description="Done-for-you creator seeding for beauty brands. Guaranteed posts every month, UGC with usage rights, Spark Ads. Plans from $499/month."
  path="/creator-seeding"
  schema={[breadcrumb(crumbs), faqPage(SERVICE_FAQS), ...services()]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">The Orbit Seeding Engine</p>
      <h1 class="h-hero">Guaranteed creator posts. <em>Ads that come with them.</em></h1>
      <p class="lead">We run your creator seeding end to end: finding and vetting creators, confirming them before you ship, chasing every post to live, and turning the best ones into ads. You approve a brief and ship product.</p>
      <div class="cta-group"><a class="btn btn--primary" href="/book" data-cta="services-hero"><Icon name="calendar" />Book a 30-minute walkthrough</a><a class="btn btn--secondary" href="#pricing">See the plans</a></div>
      <div class="chipline">
        <span><Icon name="shield-check" />Posts guaranteed by day 60</span><span><Icon name="video" />UGC with usage rights</span><span><Icon name="zap" />Spark Ads ready</span><span><Icon name="handshake" />You own every relationship</span>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--tight" aria-labelledby="process-title">
    <div class="container">
      <SectionHead id="process-title" eyebrow="The process" title="Four phases. <em>One rule.</em>" lead="No creator gets product until they confirm. It’s why 70%+ of our creators post, against 30% to 50% for cold gifting." />
      <ol class="steps">
        {phases.map((p) => (
          <li class="step reveal">
            <div class="step__top"><span class="step__n">{p.n}</span><span class="step__when">{p.when}</span></div>
            <h3 data-when={p.when}>{p.name}</h3>
            <p>{p.text}</p>
            <ul>{p.items.map((i) => <li><Icon name="check" /><span>{i}</span></li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Orbit + tracker -->
  <section class="section section--soft" aria-labelledby="orbit-title">
    <div class="container orbit-wrap">
      <div>
        <SectionHead id="orbit-title" left eyebrow="Everything included" title="One team runs <em>the whole orbit</em>." lead="Creator research, outreach, shipping, follow-ups, UGC rights, Spark Ads and reporting, run by one team on one system, with a tracker you can open any time." />
        <ul class="checks mt-6">
          <li><Icon name="check" /><span>Competitor Creator Audit and a brief you approve</span></li>
          <li><Icon name="check" /><span>Creator research, hand vetting and outreach</span></li>
          <li><Icon name="check" /><span>Confirmation before shipping, coordinated with your warehouse</span></li>
          <li><Icon name="check" /><span>Follow-up until every post is live</span></li>
          <li><Icon name="check" /><span>UGC assets with usage rights for your ads</span></li>
          <li><Icon name="check" /><span>Spark Ads codes, whitelisting and a VIP Creator Roster</span></li>
        </ul>
      </div>
      <OrbitDiagram />
    </div>
  </section>

  <section class="section" aria-labelledby="tracker-title">
    <div class="container">
      <SectionHead id="tracker-title" eyebrow="Full transparency" title="Watch every post <em>go live</em>." lead="Every creator, shipment and post link in one live tracker from day one. You verify, you don’t take our word for it." />
      <div style="max-width:980px;margin:0 auto"><Tracker /></div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section section--soft" id="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <SectionHead id="pricing-title" eyebrow="Plans" title="Pick your volume. <em>We guarantee it.</em>" lead="Every plan includes UGC with usage rights equal to at least 30% of its posts. Pricing depends on your plan and goals, and we quote it on a 30-minute call." />
      <div class="center"><p class="from-price"><Icon name="badge-dollar-sign" />Plans from <b>{PRICE_FROM}</b>/month</p></div>
      <Plans detailed />

      <div class="matrix-section">
      <h3 class="h-lg center mt-12" id="matrix-title" style="margin-top:80px">Compare plans <em>side by side</em></h3>
      <div class="matrix-wrap" tabindex="0" role="region" aria-labelledby="matrix-title">
        <table class="matrix">
          <thead><tr><th scope="col"><span class="sr-only">Feature</span></th>{TIERS.map((t) => <th scope="col" class={t.popular ? 'is-pop' : ''}>{t.name}</th>)}</tr></thead>
          <tbody>
            {matrixRows.map(([label, get]) => (
              <tr><th scope="row">{label}</th>{TIERS.map((t) => <td class={t.popular ? 'is-pop' : ''}>{get(t) === 'Included' ? <span class="mark mark--yes"><Icon name="circle-check" label="Included" /></span> : get(t)}</td>)}</tr>
            ))}
            <tr><th scope="row">Price</th>{TIERS.map((t) => <td class={t.popular ? 'is-pop' : ''}><a href="/book" data-cta={`matrix-${t.id}`}>{t.custom ? 'Custom quote' : 'Get pricing'}</a></td>)}</tr>
          </tbody>
        </table>
      </div>
      </div>
    </div>
  </section>

  <!-- Terms + add-ons -->
  <section class="section" aria-labelledby="terms-title">
    <div class="container">
      <SectionHead id="terms-title" eyebrow="Terms" title="Simple terms. <em>No long contracts.</em>" />
      <div class="terms">
        {terms.map(([icon, h, p]) => (<div class="term reveal"><span class="icon-dot icon-dot--soft"><Icon name={icon} /></span><div><h3>{h}</h3><p>{p}</p></div></div>))}
      </div>
      <div class="split mt-12" style="margin-top:64px">
        <div class="panel">
          <h2>Add-ons</h2>
          <p class="muted">Add any of these to a plan, quoted with your proposal.</p>
          <ul class="list-points">
            {ADDONS.map((a) => (<li><span class="icon-dot icon-dot--soft"><Icon name="layers" /></span><div><b>{a.name}</b><span>{a.text}</span></div></li>))}
          </ul>
        </div>
        <div class="panel">
          <h2>What you handle</h2>
          <p class="muted">Three things stay with you. We run everything else.</p>
          <ul class="list-points">
            <li><span class="icon-dot icon-dot--soft"><Icon name="package" /></span><div><b>Shipping gifted product</b><span>From your own warehouse, within three business days of each confirmation.</span></div></li>
            <li><span class="icon-dot icon-dot--soft"><Icon name="zap" /></span><div><b>Your Spark Ads spend</b><span>We secure the codes and set them up. The ad budget is yours.</span></div></li>
            <li><span class="icon-dot icon-dot--soft"><Icon name="handshake" /></span><div><b>Paying creators on paid collabs</b><span>Paid directly by you, with no markup from us.</span></div></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Fit -->
  <section class="section section--soft" aria-labelledby="fit-title">
    <div class="container">
      <SectionHead id="fit-title" eyebrow="Who it’s for" title="Built for founders who think in <em>cost per post</em>." />
      <div class="split">
        <div class="panel">
          <h2><span class="mark mark--yes"><Icon name="circle-check" />A good fit</span></h2>
          <ul class="checks mt-6">
            <li><Icon name="check" /><span>You run a DTC skincare, cosmetics or beauty brand and want to show up when shoppers search your product on TikTok</span></li>
            <li><Icon name="check" /><span>You gift product now but get a handful of posts a month, or you’ve hit what one coordinator can handle</span></li>
            <li><Icon name="check" /><span>You want UGC you can run as ads every month, not a one-off batch</span></li>
            <li><Icon name="check" /><span>You can approve a brief in 48 hours and ship within three business days</span></li>
          </ul>
        </div>
        <div class="panel">
          <h2><span class="mark mark--no"><Icon name="circle-x" />Not the right fit if</span></h2>
          <ul class="checks mt-6">
            <li><Icon name="minus" /><span>You need a guarantee on views or sales rather than posts</span></li>
            <li><Icon name="minus" /><span>Your warehouse can’t ship within three business days of confirmations</span></li>
            <li><Icon name="minus" /><span>You’re outside skincare, cosmetics or beauty</span></li>
          </ul>
          <p class="muted mt-6">We’ll tell you on the call, not after you’ve paid.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <SectionHead id="faq-title" eyebrow="FAQ" title="Questions, <em>answered</em>" />
      <Faq items={SERVICE_FAQS} />
    </div>
  </section>

  <FinalCta
    title="Get your plan and <em>your exact quote</em>."
    text={`In 30 minutes we’ll recommend a plan, show you the live tracker, and give you a price. Plans start from ${PRICE_FROM} a month.`}
    secondary={false}
    micro='Not ready for a call? <a href="/competitor-audit">Get your free Competitor Creator Audit</a>.'
  />
</BaseLayout>
