---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import CtaButtons from '../components/CtaButtons.astro';
import StatBar from '../components/StatBar.astro';
import Tracker from '../components/Tracker.astro';
import Marquee from '../components/Marquee.astro';
import OrbitDiagram from '../components/OrbitDiagram.astro';
import Plans from '../components/Plans.astro';
import CompareTable from '../components/CompareTable.astro';
import SectionHead from '../components/SectionHead.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { PROOF, PENDING, PRICE_FROM, estherMonths } from '../data/site';
import { HOME_FAQS, REVIEWS, CREATORS } from '../data/content';
import { faqPage, person, services } from '../data/schema';
const months = estherMonths();
const caseImgs = CREATORS.filter((c) => ['creator-04', 'creator-05', 'creator-11', 'creator-03', 'creator-07', 'creator-09'].includes(c.file));
const floats = [CREATORS[3], CREATORS[4], CREATORS[10]];
---
<BaseLayout
  title="Creator Seeding Agency for Beauty Brands · Influencer Orbit"
  description="Guaranteed creator posts every month for DTC skincare and beauty brands, plus UGC with usage rights for your ads. Plans from $499/month."
  path="/"
  schema={[faqPage(HOME_FAQS), person(), ...services()]}
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <p class="eyebrow">Creator seeding for DTC beauty brands</p>
      <h1 id="hero-title" class="h-hero">Creator posts you can count on. <em>Every month.</em></h1>
      <p class="lead">We run your whole creator seeding operation: hand-vetted creators, confirmed before a single box ships, followed up until every post is live. Your best posts come back as ads. Your monthly post count is guaranteed by day&nbsp;60.</p>
      <CtaButtons micro="See the live tracker and a real monthly report before you commit to anything." />
      <div class="trust-row">
        <span class="trust-row__item"><img src="/images/brand/esther-formula-logo.webp" width="869" height="96" alt="Esther Formula" /><span>client since {PROOF.estherSince}</span></span>
        <span class="sep" aria-hidden="true"></span>
        <span class="trust-row__item"><b>{PROOF.totalPosts}</b> creator posts live</span>
        <span class="sep" aria-hidden="true"></span>
        <span class="trust-row__item"><span class="platforms" role="img" aria-label="On TikTok, Instagram and YouTube"><Brand name="tiktok" decorative /><Brand name="instagram" decorative /><Brand name="youtube" decorative /></span>TikTok, Instagram, YouTube</span>
      </div>
    </div>
    <div class="stage">
      <div class="container">
        <div class="stage__inner">
          {floats.map((c, i) => (
            <figure class={`float-card float-card--${['a', 'b', 'c'][i]}`} style="margin:0" aria-hidden="true">
              <img src={`/images/creators/${c.file}-${c.width}.webp`} width={c.width} height={Math.round(c.width * 1.25)} alt="" loading="eager" />
              <span class="float-card__pill"><i></i>Live</span>
            </figure>
          ))}
          <Tracker />
        </div>
      </div>
    </div>
  </section>

  <!-- Proof numbers + creator wall -->
  <section class="section" aria-labelledby="proof-strip-title" style="padding-bottom:0">
    <div class="container">
      <h2 id="proof-strip-title" class="sr-only">Influencer Orbit in numbers</h2>
      <StatBar />
    </div>
    <div class="mt-12">
      <Marquee />
      <p class="marquee-caption">Real creator posts from the Esther Formula program, shared with the brand’s permission.</p>
    </div>
  </section>

  <!-- Problem -->
  <section class="section" aria-labelledby="problem-title">
    <div class="container">
      <SectionHead id="problem-title" eyebrow="The problem" title="Gifting is simple. <em>Getting posts back isn’t.</em>" lead="Most creator programs don’t fail on strategy. They fail on operations: boxes ship, nobody follows up, and half the product never turns into a post." />
      <div class="problem">
        <figure class="post-rate reveal">
          <figcaption class="post-rate__title">Posts you get back from every 100 boxes shipped</figcaption>
          <div class="post-rate__row">
            <div class="post-rate__label"><span>Cold gifting</span><b>30 to 50</b></div>
            <div class="post-rate__track"><i class="post-rate__range" style="left:30%;width:20%"></i><i class="post-rate__fill post-rate__fill--muted" style="width:30%"></i></div>
          </div>
          <div class="post-rate__row">
            <div class="post-rate__label"><span>Confirm-first, Influencer Orbit</span><b class="is-us">70+</b></div>
            <div class="post-rate__track"><i class="post-rate__fill" style="width:70%"></i></div>
          </div>
          <div class="post-rate__boxes" aria-hidden="true">
            {Array.from({ length: 20 }).map((_, i) => <span class={i < 14 ? 'on' : ''}></span>)}
          </div>
          <p class="post-rate__note">Cold gifting range: <a href="https://blog.hypeauditor.com/how-to-get-influencers-to-post-about-your-brand-during-a-gifting-campaign/" target="_blank" rel="noopener">HypeAuditor</a>. Confirm-first: Influencer Orbit program data.</p>
        </figure>
        <div class="problem__cards">
          <div class="problem-card reveal">
            <span class="icon-dot"><Icon name="package" /></span>
            <div><h3>Boxes that disappear</h3><p>Product ships to creators who never confirmed. Three weeks later, half of it has turned into nothing.</p></div>
          </div>
          <div class="problem-card reveal">
            <span class="icon-dot"><Icon name="search" /></span>
            <div><h3>Your competitors own TikTok search</h3><p>Search your brand and find almost nothing. Search a competitor with a weaker formula and scroll through dozens of real faces.</p></div>
          </div>
          <div class="problem-card reveal">
            <span class="icon-dot"><Icon name="badge-dollar-sign" /></span>
            <div><h3>Ads that burn out</h3><p>US Meta prices per ad rose 23% year over year in Q3 2026, and your creative dies every few weeks with nothing fresh behind it.</p></div>
          </div>
        </div>
      </div>
      <div class="answer-band reveal">
        <p class="answer-band__claim">The problem isn’t creator seeding. It’s running it by hand.</p>
        <p>Influencer Orbit runs the whole operation for you, from 12 to 150+ guaranteed creator posts a month, with UGC you’re allowed to run as ads. You approve a brief and ship product. We do everything else.</p>
      </div>
    </div>
  </section>

  <!-- Solution: the orbit -->
  <section class="section section--soft" aria-labelledby="orbit-title">
    <div class="container orbit-wrap">
      <div>
        <SectionHead id="orbit-title" left eyebrow="Our solution" title="Everything around your brand, <em>in one orbit</em>." lead="One team runs every part of creator seeding, so nothing falls between the cracks of freelancers, tools and spreadsheets." />
        <div class="feature-list">
          <div class="feature"><span class="icon-dot"><Icon name="circle-check" /></span><div><h3>Confirm-first seeding</h3><p>No creator gets product until they confirm. That one rule is why 70%+ of our creators post.</p></div></div>
          <div class="feature"><span class="icon-dot"><Icon name="video" /></span><div><h3>UGC you can run as ads</h3><p>Every plan includes creator videos with usage rights, at least 30% of your posts, plus Spark Ads codes.</p></div></div>
          <div class="feature"><span class="icon-dot"><Icon name="handshake" /></span><div><h3>You own every relationship</h3><p>Every creator contact, content link and the tracker stay yours, even if you leave.</p></div></div>
        </div>
      </div>
      <OrbitDiagram />
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="how-it-works" aria-labelledby="how-title">
    <div class="container">
      <SectionHead id="how-title" eyebrow="How it works" title="The Orbit Seeding Engine: <em>four phases</em>, one rule." lead="No creator gets product until they confirm. Everything else is built around getting real posts live on schedule." />
      <ol class="steps">
        <li class="step reveal">
          <div class="step__top"><span class="step__n">1</span><span class="step__when">Days 1 to 5</span></div>
          <h3 data-when="Days 1 to 5">Map</h3>
          <p>A Competitor Creator Audit shows which creators post for your top 3 competitors and which hooks win. It becomes your brief.</p>
        </li>
        <li class="step reveal">
          <div class="step__top"><span class="step__n">2</span><span class="step__when">Days 5 to 21</span></div>
          <h3 data-when="Days 5 to 21">Match &amp; Ship</h3>
          <p>We hand-vet creators for audience fit, not follower count. Each one confirms before your warehouse ships.</p>
        </li>
        <li class="step reveal">
          <div class="step__top"><span class="step__n">3</span><span class="step__when">Day 21 on</span></div>
          <h3 data-when="Day 21 on">Go Live</h3>
          <p>We follow up until every post is live, and you watch it happen in a live tracker you own.</p>
        </li>
        <li class="step reveal">
          <div class="step__top"><span class="step__n">4</span><span class="step__when">Day 30 on</span></div>
          <h3 data-when="Day 30 on">Amplify</h3>
          <p>Your best posts become Spark Ads, and top creators join your VIP Creator Roster for repeat seeding.</p>
        </li>
      </ol>
      <div class="timeline-strip">
        <div><b>21 days</b><span>to your first creator posts</span></div>
        <div><b>Day 60</b><span>your monthly post count, guaranteed</span></div>
        <div><b>{PROOF.postRate}</b><span>of our gifted creators post</span></div>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="section section--soft" aria-labelledby="included-title">
    <div class="container">
      <SectionHead id="included-title" eyebrow="What you get" title="A full creator team, <em>without the hire</em>." lead="Everything a strong in-house influencer team would do, run on a system that’s been tested every month since January 2024." />
      <div class="grid grid--4">
        <div class="card card--hover reveal"><span class="icon-dot icon-dot--soft"><Icon name="scan-search" /></span><h3>Competitor Creator Audit</h3><p>See who already posts for your competitors and what wins in your category.</p></div>
        <div class="card card--hover reveal"><span class="icon-dot icon-dot--soft"><Icon name="user-check" /></span><h3>Hand-vetted creators</h3><p>Picked for audience fit, engagement quality and content match.</p></div>
        <div class="card card--hover reveal"><span class="icon-dot icon-dot--soft"><Icon name="send" /></span><h3>Outreach and confirmation</h3><p>We negotiate, brief and confirm every creator before anything ships.</p></div>
        <div class="card card--hover reveal"><span class="icon-dot icon-dot--soft"><Icon name="truck" /></span><h3>Shipping coordination</h3><p>Confirmed addresses go to your warehouse daily, ready to ship.</p></div>
        <div class="card card--hover reveal"><span class="icon-dot icon-dot--soft"><Icon name="repeat" /></span><h3>Follow-up to live</h3><p>We chase every creator until the post is up, not just the easy ones.</p></div>
        <div class="card card--hover reveal"><span class="icon-dot icon-dot--soft"><Icon name="video" /></span><h3>UGC with usage rights</h3><p>Creator videos you’re allowed to run in your own ads, every month.</p></div>
        <div class="card card--hover reveal"><span class="icon-dot icon-dot--soft"><Icon name="zap" /></span><h3>Spark Ads and whitelisting</h3><p>Your top posts flagged, with codes secured so your media buyer can run them.</p></div>
        <div class="card card--hover reveal"><span class="icon-dot icon-dot--soft"><Icon name="chart-no-axes-column" /></span><h3>Live tracker and reports</h3><p>Every creator, shipment and post link in real time, plus a report you can act on.</p></div>
      </div>
    </div>
  </section>

  <!-- Mid CTA band -->
  <section class="section" aria-labelledby="band-title" style="padding-bottom:0">
    <div class="container">
      <div class="band on-dark reveal">
        <svg class="band__orbit" viewBox="0 0 400 400" aria-hidden="true"><g fill="none" stroke="#BCD3FF" stroke-width="1.2"><ellipse cx="200" cy="200" rx="190" ry="70" transform="rotate(-20 200 200)"/><ellipse cx="200" cy="200" rx="140" ry="50" transform="rotate(-20 200 200)"/></g></svg>
        <h2 id="band-title" class="h-xl">Stop shipping product into the void. <em>Start counting posts.</em></h2>
        <p>In 30 minutes we’ll show you the live tracker, the report you’d get, and the cost-per-post math against what you spend now.</p>
        <div class="mt-8"><CtaButtons dark secondary={false} micro={false} /></div>
      </div>
    </div>
  </section>

  <!-- Plans -->
  <section class="section" id="plans" aria-labelledby="plans-title">
    <div class="container">
      <SectionHead id="plans-title" eyebrow="Plans" title="Pick your volume. <em>We guarantee it.</em>" lead="Four plans, each with a guaranteed monthly post count and UGC with usage rights. Every plan starts with a 60-day pilot, then runs month to month." />
      <div class="center"><p class="from-price"><Icon name="badge-dollar-sign" />Plans from <b>{PRICE_FROM}</b>/month<span class="from-price__extra"> · exact quote on a 30-minute call</span></p></div>
      <Plans />
      <div class="pricing-note">
        <span><Icon name="shield-check" />Post count guaranteed by day 60</span>
        <span><Icon name="clock" />First posts within 21 days</span>
        <span><Icon name="repeat" />Month to month after the pilot</span>
      </div>
      <p class="center mt-6"><a class="text-link" href="/creator-seeding#pricing">Compare every plan in detail <Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <!-- Guarantee -->
  <section class="section section--tight" style="padding-bottom:0" aria-labelledby="guarantee-title">
    <div class="container">
      <div class="guarantee reveal">
        <div>
          <p class="guarantee__label"><Icon name="shield-check" />The guarantee</p>
          <h2 id="guarantee-title" class="h-xl">Your post count, live by day&nbsp;60. <em>In writing.</em></h2>
          <p class="mt-6">First creator posts go live within 21 days. Your plan’s monthly post count is hit by day 60, counted from when you ship product. If we miss it, we keep working at no charge until we hit it.</p>
          <p class="fine">We guarantee posts, not views. Posting is what we control. The algorithm isn’t.</p>
        </div>
        <div class="guarantee__seal">
          <div class="seal-row"><Icon name="timer" /><div><b>21 days</b><span>to first creator posts</span></div></div>
          <div class="seal-row"><Icon name="target" /><div><b>Day 60</b><span>monthly post count hit</span></div></div>
          <div class="seal-row"><Icon name="handshake" /><div><b>No charge</b><span>until we hit it, if we miss</span></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Case study -->
  <section class="section" aria-labelledby="case-title">
    <div class="container">
      <SectionHead id="case-title" eyebrow="Case study" title="One beauty brand. <span data-months>{months}</span> months. <em>Every single month.</em>" lead="We keep our proof deep, not wide: the same client, the same system, month after month." />
      <article class="case reveal">
        <div class="case__media">
          {caseImgs.map((c) => (
            <picture>
              <source type="image/avif" srcset={`/images/creators/${c.file}-${c.width}.avif`} />
              <img src={`/images/creators/${c.file}-${c.width}.webp`} width={c.width} height={Math.round(c.width * 1.25)} alt={c.alt} loading="lazy" decoding="async" />
            </picture>
          ))}
        </div>
        <div class="case__body">
          <div class="case__tags"><span class="tag">Skincare + supplements</span><span class="tag">Since Jan 2024</span></div>
          <img class="case__logo" src="/images/brand/esther-formula-logo.webp" width="869" height="96" alt="Esther Formula" loading="lazy" />
          <h3>50 to 200 creator posts a month, without hiring an influencer manager</h3>
          <p class="muted">Esther Formula, a Korean skincare and beauty supplement brand, has run its creator seeding operation with us since January 2024.</p>
          <div class="case__metrics">
            <div><b>{PROOF.collaborations}</b><span>creator collaborations</span></div>
            <div><b>{PROOF.totalPosts}</b><span>creator posts live</span></div>
            <div><b>{PROOF.postRate}</b><span>post rate, confirm-first</span></div>
            <div><b>{PROOF.shipmentsPerMonth}</b><span>shipments a month</span></div>
          </div>
          <a class="text-link" href="/case-studies">Read the case study <Icon name="arrow-right" /></a>
        </div>
      </article>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--soft" aria-labelledby="reviews-title">
    <div class="container">
      <SectionHead id="reviews-title" eyebrow="Testimonials" title="What clients <em>say about us</em>" />
      {PENDING.estherVideo && (
        <div class="video-feature">
          <div class="video-card"><video src={PENDING.estherVideo.src} poster={PENDING.estherVideo.poster} controls preload="none" playsinline aria-label={`Video testimonial from ${PENDING.estherVideo.name}, Esther Formula`}></video></div>
          <div>
            <img src="/images/brand/esther-formula-logo.webp" width="869" height="96" alt="Esther Formula" style="width:200px" loading="lazy" />
            <p class="h-lg mt-6">Hear it from the Esther Formula team.</p>
            <p class="muted mt-4">{PENDING.estherVideo.name}, {PENDING.estherVideo.title}, Esther Formula</p>
          </div>
        </div>
      )}
      {PENDING.estherTestimonial && (
        <blockquote class="card mt-6" style="max-width:860px;margin:0 auto 32px"><p class="h-md" style="color:var(--text)">“{PENDING.estherTestimonial.quote}”</p><footer class="muted mt-4">{PENDING.estherTestimonial.name}, {PENDING.estherTestimonial.title}, Esther Formula</footer></blockquote>
      )}
      <div class="reviews" tabindex="0" role="region" aria-label="Client reviews">
        {REVIEWS.map((r) => <ReviewCard {...r} />)}
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section" aria-labelledby="compare-title">
    <div class="container">
      <SectionHead id="compare-title" eyebrow="Why us" title="How we’re <em>different</em>" lead="The three options most founders weigh, side by side." />
      <CompareTable labelledby="compare-title" />
      <p class="table-note">In-house cost is a US influencer marketing coordinator’s salary before software.</p>
    </div>
  </section>

  <!-- Founder -->
  <section class="section section--soft" aria-labelledby="founder-title">
    <div class="container founder">
      <div class="founder__photo">
        <picture>
          <source type="image/avif" srcset="/images/brand/tayyab-habib-480.avif 480w, /images/brand/tayyab-habib-800.avif 800w" sizes="(min-width: 1024px) 420px, 90vw" />
          <img src="/images/brand/tayyab-habib-800.webp" srcset="/images/brand/tayyab-habib-480.webp 480w, /images/brand/tayyab-habib-800.webp 800w" sizes="(min-width: 1024px) 420px, 90vw" width="800" height="800" alt="Tayyab Habib, founder of Influencer Orbit" loading="lazy" />
        </picture>
        <div class="founder__badge"><img src="/images/brand/app-icon-192.png" width="36" height="36" alt="" /><div><b>Tayyab Habib</b>Founder, Influencer Orbit</div></div>
      </div>
      <div class="founder__text">
        <p class="eyebrow">Meet the founder</p>
        <h2 id="founder-title" class="h-xl">I care about one number: <em>posts against target.</em></h2>
        <p class="mt-6">After running influencer work for 100+ brands, I saw the same thing in almost every gifting program: product went out, half the creators never posted, and nobody followed up.</p>
        <p>So we built the Orbit Seeding Engine, a confirm-first operation with one job: real creator posts, every month, at volume. We’ve run it for the same beauty brand for <span data-months>{months}</span> months.</p>
        <p class="founder__sign">Tayyab Habib</p>
        <a class="btn btn--primary mt-6" href="/book" data-cta="founder"><Icon name="calendar" />Book a call with Tayyab</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <SectionHead id="faq-title" eyebrow="FAQ" title="Questions founders ask <em>before booking</em>" />
      <Faq items={HOME_FAQS} />
      <p class="center mt-8"><a class="text-link" href="/creator-seeding#faq">See all questions <Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <!-- Free resources -->
  <section class="section section--soft" aria-labelledby="resources-title">
    <div class="container">
      <SectionHead id="resources-title" eyebrow="Free resources" title="Start for free, <em>no call needed</em>" />
      <div class="grid grid--3">
        <a class="card card--hover resource" href="/competitor-audit">
          <span class="resource__media"><Icon name="scan-search" /></span>
          <h3>Free Competitor Creator Audit</h3>
          <p>See which creators already post for your top 3 competitors, and which hooks win. Delivered in 5 business days.</p>
          <span class="text-link">Get your audit <Icon name="arrow-right" /></span>
        </a>
        <a class="card card--hover resource" href="#newsletter">
          <span class="resource__media"><Icon name="mail" /></span>
          <h3>The Seeding Report</h3>
          <p>One short email a month on what’s working in creator seeding for beauty brands, with plays you can copy.</p>
          <span class="text-link">Subscribe free <Icon name="arrow-right" /></span>
        </a>
        <a class="card card--hover resource" href="/case-studies">
          <span class="resource__media"><Icon name="file-text" /></span>
          <h3>The Esther Formula case study</h3>
          <p>How one rule took a gifting program to a 70%+ post rate and {PROOF.totalPosts} posts live.</p>
          <span class="text-link">Read the story <Icon name="arrow-right" /></span>
        </a>
      </div>
    </div>
  </section>

  <FinalCta
    title="Ready to see your posts <em>go live next month</em>?"
    text="In 30 minutes we’ll show you the live tracker and the report you’d receive, then run the cost-per-post math against what you spend now."
    secondary={false}
    micro='Not ready for a call? <a href="/competitor-audit">Get your free Competitor Creator Audit</a>.'
  />
</BaseLayout>
