# Influencer Orbit — Hostinger (Apache / LiteSpeed) rules
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One canonical address: https://influencerorbit.com (no www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://influencerorbit.com%{REQUEST_URI} [L,R=301,NE]

  # 2. Old or alternative URLs
  RewriteRule ^(services|seeding-engine)/?$ /creator-seeding [L,R=301]
  RewriteRule ^pricing/?$ /creator-seeding#pricing [L,R=301,NE]
  RewriteRule ^contact/?$ /book [L,R=301]
  RewriteRule ^audit/?$ /competitor-audit [L,R=301]
  RewriteRule ^case-study/?$ /case-studies [L,R=301]

  # 3. /index.html -> /   and   /page.html -> /page
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # 4. Drop trailing slashes on pages
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 5. Serve /page from page.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ /$1.html [L]
</IfModule>

# File types
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
  AddCharset utf-8 .html .txt .xml .webmanifest
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Caching: fonts and images for a long time, pages always fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Keep source-control and config files private
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
